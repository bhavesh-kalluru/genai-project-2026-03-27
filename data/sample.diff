+"""
+Simple in-memory LRU cache utility.
+"""
+
+import logging
+from collections import OrderedDict
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+
+class LRUCache:
+    """Thread-safe LRU cache with configurable max size."""
+
+    def __init__(self, max_size: int = 128):
+        self._max_size = max_size
+        self._cache: OrderedDict = OrderedDict()
+
+    def get(self, key: str) -> Optional[Any]:
+        """Retrieve item, moving it to most-recently-used position."""
+        if key in self._cache:
+            self._cache.move_to_end(key)
+            return self._cache[key]
+        return None
+
+    def put(self, key: str, value: Any) -> None:
+        """Insert or update item, evicting LRU if at capacity."""
+        if key in self._cache:
+            self._cache.move_to_end(key)
+        self._cache[key] = value
+        if len(self._cache) > self._max_size:
+            evicted = self._cache.popitem(last=False)
+            logger.debug(f"Evicted cache entry: {evicted[0]}")
+
+    def clear(self) -> None:
+        self._cache.clear()
